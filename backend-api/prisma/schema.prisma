generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PLAYER
}

enum MatchStatus {
  OPEN
  FULL
  CANCELLED
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  name     String?
  password String
  role     UserRole @default(PLAYER)

  createdMatches Match[]       @relation("MatchCreator")
  matchPlayers   MatchPlayer[]

  @@map("users")
}

model Pitch {
  id       String @id @default(uuid())
  name     String
  location String

  matches Match[]

  @@map("pitches")
}

model Match {
  id          String      @id @default(uuid())
  scheduledAt DateTime
  duration    Int         @default(60)
  maxPlayers  Int         @default(12)
  status      MatchStatus @default(OPEN)

  pitchId   String
  creatorId String

  pitch        Pitch         @relation(fields: [pitchId], references: [id])
  creator      User          @relation("MatchCreator", fields: [creatorId], references: [id])
  matchPlayers MatchPlayer[]

  @@index([scheduledAt])
  @@index([pitchId])
  @@index([creatorId])
  @@map("matches")
}

model MatchPlayer {
  userId  String
  matchId String

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
  @@index([matchId])
  @@map("match_players")
}
